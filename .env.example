# ---------------------------------------------------------------------------
# Both variables are OPTIONAL.
# Without them the app still works fully — it just runs in local-only mode
# (memos are stored in the browser via IndexedDB) and account sign-up is
# disabled with a clear message in the UI.
# ---------------------------------------------------------------------------

# Postgres connection string. Enables accounts + server-side memo storage.
# Works with Vercel Postgres / Neon / Supabase / any Postgres 12+.
# Neon & Supabase require sslmode=require.
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies AND to derive the keys that encrypt the
# stored e-mail addresses. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Do NOT change this once accounts exist: the e-mail encryption key and the
# lookup index are derived from it, so changing it locks existing users out.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Admin panel (/admin) — OPTIONAL, disabled unless every variable below AND
# POSTGRES_URL / AUTH_SECRET above are set. Lets a listed admin sign in with a
# one-time e-mail code to view and delete accounts. "Admin" is just an address
# on this list — it does not need its own memo account.
# ---------------------------------------------------------------------------

# Comma-separated allowlist of admin e-mail addresses.
ADMIN_EMAILS="you@example.com"

# SMTP server used to send the one-time login code. Works with any provider
# that exposes SMTP credentials (a mailbox, SendGrid, Mailgun, Amazon SES, ...).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="username"
SMTP_PASS="password"
# The From: address on the login-code e-mail.
SMTP_FROM="メモアプリ <no-reply@example.com>"
# Set to "true" only if your provider requires implicit TLS on a port other
# than 465 (465 already defaults to secure).
SMTP_SECURE=""
