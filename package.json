{
  "name": "pwa-memo",
  "version": "1.0.0",
  "private": true,
  "description": "PWA memo app with local-only or account-based server storage, deployable to Vercel",
  "scripts": {
    "dev": "node scripts/generate-icons.mjs && next dev",
    "build": "node scripts/generate-icons.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "next": "^15.5.24",
    "nodemailer": "^9.1.1",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "22.15.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "^15.5.24",
    "typescript": "5.9.2"
  }
}
